module uart
(
    input   logic   CLK_i,
    input   logic   RST_n_i,
    
    output  logic   [3:0] count_o
);
logic [3:0] count;

always_ff @(posedge CLK_i or negedge RST_n_i) begin
    if (~RST_n_i) begin
        count <= 4'h0;
    end else begin
        count <= count + 1;
    end
end

assign count_o = count;

endmodule
