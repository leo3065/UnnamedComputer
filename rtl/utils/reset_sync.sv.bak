module reset_sync (
    input   CLK_sys,
    input   RST_n,
    output  RST_sync_n
);
logic rst_pre;

always_ff @(posedge CLK_sys or negedge RST_n) begin
    if (!RST_n) begin
        rst_pre <= 1'b0;
        RST_sync_n <= 1'b0;
    end else begin
        rst_pre <= 1'b1;
        RST_sync_n <= rst_pre;
    end
end
endmodule
